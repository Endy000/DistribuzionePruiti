<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supporto clienti</title>
    <link rel="stylesheet" href="/ext.css">
    <link rel="icon" href="./Assets/Redist/a.png">
</head>

<body>

<header>
    <a href="/" id="tit"><h1>Distribuzione Pruiti</h1></a>
    <img src="./Assets/Redist/a.png" alt="logo" id="logo">
</header>

<main id="Spazio-supporto">

    <form id="support-form" action="/supporto" method="post">

        <fieldset>
            <legend>Supporto clienti</legend>

            <textarea name="problema" id="prb" placeholder="Scrivi qui il tuo problema..."></textarea>

            <button type="submit">Invia richiesta</button>
        </fieldset>

    </form>

</main>

<section id="quick-help">

    <h3>Problemi frequenti</h3>

    <a class="help-btn" href="/supporto/password">Ho dimenticato la password</a>
    <a class="help-btn" href="/supporto/ordine">Tracciamento ordine</a>

</section>

</body>
</html>