<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/index.css">
    <link rel="icon" href="./Assets/Redist/a.png" id="Icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=BBH+Sans+Hegarty&display=swap" rel="stylesheet">
    <title>Distribuzione Pruiti</title>
</head>

<body>

<header>
    <a href="">
        <h1 id="tit">Distribuzione Pruiti</h1>
    </a>

    <div id="img1">
        <img src="./Assets/Redist/a.png" alt="logo" id="logo">
    </div>

    <% if(utente){ %>
        <p>Benvenuto <%= utente %>!</p>
    <% } %>

    <div id="links">
        <% if(utente){ %>
            <a href="/chi" class="link">Chi siamo?</a>
            <a href="/supporto/ordini" class="link">Ordini</a>
            <a href="/login/out" class="link">Logout</a>
        <% } else{ %>
            <a href="/chi" class="link">Chi siamo?</a>
            <!-- <a href="/login" id="l4" class="link">Login</a>
            <a href="/register" id="l5" class="link">Registrati</a> -->
        <% } %>
    </div>
</header>

<div id="Spazio">

    <nav id="navi">

        <form id="filterform" action="/" method="GET">

            <!-- SEARCH -->
            <input type="text" name="search" placeholder="Cerca copertone..." id="search">
            <div id="autocomplete"></div>

            <!-- MARCA -->
            <fieldset>
                <legend>Marca</legend>

                <% filtri.tipologia.forEach(t => { %>

                    <input type="checkbox"
                           name="tipologia"
                           value="<%= t.Tipo %>"
                           id="tip-<%= t.Tipo %>">

                    <label for="tip-<%= t.Tipo %>">
                        <%= t.Tipo %>
                    </label><br>

                <% }) %>
            </fieldset>

            <!-- Disegno -->
            <fieldset>
                <legend>Categoria</legend>

                <% filtri.stile.forEach(s => { %>

                    <input type="checkbox"
                           name="stile"
                           value="<%= s.Stile %>"
                           id="stile-<%= s.Stile %>">

                    <label for="stile-<%= s.Stile %>">
                        <%= s.Stile %>
                    </label><br>

                <% }) %>
            </fieldset>

            <!-- MARCA -->
            <fieldset>
                <legend>Marche Rinomate</legend>

                <% filtri.marca.forEach(m => { %>

                    <input type="checkbox"
                           name="marca"
                           value="<%= m.Marca %>"
                           id="marca-<%= m.Marca %>">

                    <label for="marca-<%= m.Marca %>">
                        <%= m.Marca %>
                    </label><br>

                <% }) %>
            </fieldset>

            <!-- DISEGNO -->
            <fieldset>
                <legend>Disegni</legend>

                <% filtri.disegno.forEach(d => { %>

                    <input type="checkbox"
                           name="disegno"
                           value="<%= d.Disegno %>"
                           id="disegno-<%= d.Disegno %>">

                    <label for="disegno-<%= d.Disegno %>">
                        <%= d.Disegno %>
                    </label><br>

                <% }) %>
            </fieldset>

        </form>
    </nav>

    <!-- RISULTATI -->
    <div id="spazioc">

        <% copertoni.forEach(copertone => { %>

            <div class="copertone">

                <img src="./Assets/Shop_Assets/<%= copertone.ID %>.jpeg" alt="foto copertone">

                <h1 class="h1"><%= copertone.Nome %></h1>

                <h2 class="h2"><%= copertone.Marca %></h2>

                <p class="p">Prezzo: <%= copertone.Prezzo %> €</p>

            </div>

        <% }) %>

    </div>

</div>

<!-- CARRELLO
<button id="pcar">
    <img width="30" height="30"
         src="https://img.icons8.com/ios-glyphs/30/shopping-cart--v1.png">
</button>

<div id="carrello" style="display: none;">
    <h2>Carrello</h2>
    <ul id="carrello-list"></ul>
    <p id="totale">Totale: 0 €</p>
    <button id="checkout">Checkout</button>
</div> -->

<!-- FOOTER -->
<footer class="site-footer">

    <div class="footer-container">

        <div class="footer-section">
            <h3>Distribuzione Pruiti</h3>
            <p>Affidabilità e qualità nella distribuzione.</p>
        </div>

        <div class="footer-section">
            <h4>Contatti</h4>
            <p>Email: info@distribuzionepruiti.it</p>
            <p>Telefono: +39 000 000 0000</p>
        </div>

        <!-- <div class="footer-section">
            <h4>Link utili</h4>
            <ul>
                <li><a href="chi">Chi siamo?</a></li>
                <li><a href="IL">Informazioni Legali</a></li>
                <li><a href="supporto">Supporto clienti</a></li>
            </ul>
        </div> -->

    </div>

    <div class="footer-bottom">
        <a id="admin-link" href="/adminlogin">©</a>
        <p>2025 Distribuzione Pruiti. Tutti i diritti riservati.</p>
    </div>

</footer>

<script src="/js/ricerca.js"></script>

</body>
</html>